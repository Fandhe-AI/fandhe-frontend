[package]
name = "fandhe-frontend-example-ssg-blog"
version = "0.1.0"
edition = "2021"
description = "fandhe-frontend フレームワークの SSG（generate_pages）正本サンプル（examples 規約、イシュー #501）。"
license = "MIT OR Apache-2.0"
publish = false

# examples/ は「crates.io 公開済みクレートを実際に使う正本サンプル」であり、
# templates/（`fw new` が展開する雛形）とは異なりバージョン依存で完結する。
# fandhe-frontend-server 0.2.0（イシュー #1119 で追加された generate_assets を
# 含む）への追随に伴い、推移的に依存する fandhe-frontend-core も 0.2.0 へ
# 揃える（イシュー #1135。sparse index への再照会で両者とも非 yanked を確認
# 済み）。
[dependencies]
fandhe-frontend-core = "0.2.0"
fandhe-frontend-server = "0.2.0"

[dev-dependencies]

# root workspace（リポジトリ直下 Cargo.toml の `members = ["crates/*"]`）から
# 意図的に切り離す。examples/ssg-blog は「フレームワーク利用者へ提示する
# 独立プロジェクトの正本サンプル」であり、root workspace に巻き込まれると
# crates.io バージョン依存と root の path 依存（`crates/*`）が衝突しうる。
# templates/default・templates/app・examples/ssr-routing と同じ方針
# （`ci.md` #412/#493/#499 参照）。
[workspace]
members = ["."]
