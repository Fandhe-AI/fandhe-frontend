[package]
name = "fandhe-frontend-example-headless-pre-styled-ui"
version = "0.1.0"
edition = "2021"
description = "fandhe-frontend-headless-ui / fandhe-frontend-pre-styled-ui（ark-ui / chakra-ui 参考の 2 層 UI コンポーネント構成）のショーケース正本サンプル（イシュー #552）。"
license = "MIT OR Apache-2.0"
publish = false

# examples/ は「crates.io 公開済みクレートを実際に使う正本サンプル」であり、
# templates/（`fw new` が展開する雛形）とは異なりバージョン依存で完結する
# （examples 規約、イシュー #499）。`fandhe-frontend-headless-ui` は当初
# crates.io 未公開のため path 依存の意図的な例外だった（イシュー #552）が、
# 前提クレート公開（イシュー #608）を受けてイシュー #609 でバージョン依存へ
# 切り替え済み。`fandhe-frontend-pre-styled-ui`（chakra-ui 相当の上層、
# #520/#546）は v0.3.1 で公開 API（styled 部品・headless ラッパー・
# StyleSheet/Theme）が揃ったため、#552 当時の「手書き CSS による暫定代替」を
# 置き換える形で依存に追加した（2 層構成のショーケースとして統合）。
# headless-ui への直接依存は Switch / RadioGroup / Avatar（pre-styled-ui 未提供
# コンポーネント）の実演のため継続する。
[dependencies]
fandhe-frontend-core = "0.1.0"
fandhe-frontend-headless-ui = "0.3.0"
fandhe-frontend-pre-styled-ui = "0.3.1"

[dev-dependencies]

# root workspace（リポジトリ直下 Cargo.toml の `members = ["crates/*"]`）から
# 意図的に切り離す。他の examples/* と同じ方針（`ci.md` 参照）。
[workspace]
members = ["."]
