[package]
name = "app-csr-wasm"
version = "0.1.0"
edition = "2021"
description = "fw new --template app（イシュー #411）が同梱する CSR wasm ビルド用の薄い glue クレート。fandhe-frontend-wasm-client（crates.io、イシュー #412 でバージョン依存へ切替）の hydrate/mount_csr を再エクスポートするのみ。"
license = "MIT OR Apache-2.0"
publish = false

# 独立ワークスペース（イシュー #411 実装計画 §2.2）:
#
# このクレートは templates/app（fandhe-frontend-template-app、外部依存ゼロの既定経路）
# とは意図的に別ワークスペースとして切り離す。wasm-bindgen / web-sys の
# 取得にはビルド時ネットワークが必要であり、これを root クレートの依存
# グラフへ混ぜると `cargo build`/`cargo test`/`fw gate` の既定経路（オフライン・
# 自己完結が前提、docs/design/fw-new-design.md §3a）を壊してしまう。
#
# `[workspace] members = ["."]` により、このディレクトリ（templates/app/wasm/）
# を独立したワークスペースルートとして確定させる。これがないと cargo は
# 親ディレクトリを遡って templates/app/Cargo.toml の `[workspace]`
# （members = ["."]、このクレートを含まない）を見つけてしまい、
# 「current package believes it's in a workspace when it's not」エラーになる。
[workspace]
members = ["."]

# REQ-3 整理（イシュー #411 実装計画 §3、#412 でバージョン依存へ切替）:
# wasm-bindgen / web-sys は fandhe-frontend-wasm-client の推移的依存として
# リポジトリ本体 Cargo.lock が既に解決済みのバージョン系列
# （wasm-bindgen 0.2.127 / web-sys 0.3.104）と同一を wasm/Cargo.lock で
# ピンする。新規外部クレートの追加はゼロ（既存解決値の参照のみ）。
# root（templates/app 直下）の依存グラフには一切含まれないため、
# REQ-3（60 件/深さ 6）の計測基準（標準サーバー構成）への影響もない。
[dependencies]
# イシュー #1324 で wasm-client 0.4.0 へバンプ（`template_vendor_drift`
# テストが正本 version との一致を強制するため追随必須）。イシュー #1375
# （keyed diff の軽量ハッシャ化）に伴う core 0.4.0 バンプの連鎖で
# wasm-client も 0.5.0 へバンプ（diff_keys/diff_keyed_items の Result 化が
# pub re-export 経由で公開 API に波及する破壊的変更のためマイナーバンプ）
# したため、本テンプレート側も追随する。イシュー #1374（find_child_by_key
# の sibling 走査をキー→Element ハンドルキャッシュへ統合）は当初 0.5.0 の
# 枠内への吸収を予定していたが、PR #1392 codex-review P1 是正（公開クレート
# の src/ 変更に対するバンプ必須条項の適用）を受けて 0.5.1 への独立 patch
# バンプへ切り替えたため、本テンプレート側も 0.5.1 へ追随した。イシュー
# #1376（core の keyed diff 前段スキップ）で fandhe-frontend-core 0.4.1 →
# 依存元（interactive/headless-ui/.../wasm-client）が連鎖的にパッチバンプ
# された（0.5.1 → 0.5.2）ため、本テンプレート側も追随する。イシュー
# #1382（`sync_attrs` への属性同値スキップ追加）で 0.5.2 → 0.5.3 へ
# パッチバンプされ、続けてイシュー #1384（keyed list アイテムの構造同型
# 判定と束縛点パス導出）で fandhe-frontend-core 0.4.1 → 0.4.2 への公開 API
# 追加バンプが連鎖した。PR #1398 codex-review P1 指摘（`.claude/rules/coding-rust.md`
# の semver バンプ必須条項は Cargo.toml 変更を伴う PR での本クレート自身の
# version バンプも要求する）を受け、wasm-client 自体も 0.5.3 → 0.5.4 へ
# パッチバンプした。さらにイシュー #1381（`KeyedOp::Update` 適用の子ノード
# 最小差分化、`KeyedListApplyResult::ResyncRequired` への `dom_mutated`
# フィールド追加）で 0.5.4 → 0.6.0 へマイナーバンプされたため、本テンプレート
# 側も 0.6.0 へ追随する。イシュー #1388（panic 整形機構の縮減、内部実装
# のみ・公開 API 不変）で wasm-client 0.6.0 → 0.6.1 へパッチバンプされた
# ため、本テンプレート側も追随する。
fandhe-frontend-wasm-client = "0.6.1"

[lib]
crate-type = ["cdylib"]

# CSR payload 削減のためのビルドプロファイル調整（イシュー #1327）:
#
# rustc 既定（opt-level=3 / lto=off / codegen-units=16）は wasm32-unknown-unknown
# 出力の実行速度を優先しサイズを最適化しない。本クレートは glue（実処理は
# fandhe-frontend-wasm-client）で実行時性能要求が薄いため、サイズ優先へ振る。
# `docs/ci/wasm-opt-adoption-evaluation.md` の実測（本テンプレート crate 自体
# を用いた比較）で `opt-level = "s"` が `"z"`/`3` のいずれよりも小さい gzip
# サイズを示したため `"s"` を採用する（`"z"` の方が小さくなる想定に反する
# 逆転が実測で確認されており、憶測でなく実測に従う）。
# lto = true（fat LTO）・codegen-units = 1 はクレート境界を越えたインライン化・
# デッドコード除去を最大化するため、サイズ削減効果が大きい方を採用（thin LTO
# との比較も同文書に記載）。panic = "abort" は unwind テーブル分の出力を削減
# する（本クレートは catch_unwind を使わない）。strip = "debuginfo" は wasm32
# ターゲットでは release ビルドでも残り得るデバッグ情報を明示的に落とす。
[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
panic = "abort"
strip = "debuginfo"
