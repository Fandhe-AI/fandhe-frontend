[package]
name = "fandhe-frontend-template-app"
version = "0.1.0"
edition = "2021"
description = "fandhe-frontend フレームワークの拡張プロジェクトテンプレート（fandhe-frontend-core / fandhe-frontend-app 依存、Loader・束縛点・render の実体サンプル、イシュー #378）。"
license = "MIT OR Apache-2.0"
publish = false

# REQ-3 / coding-rust.md: fandhe-frontend-core / fandhe-frontend-app は crates.io 公開済み
# （v0.1.0）のため、通常の crates.io バージョン依存を使う（イシュー #412 の
# 切替手順、docs/design/template-vendor-to-version-switch.md）。
# ビルドの決定性（同一入力 → 同一出力）は同梱の Cargo.lock が担保する
# （バージョン要件自体は Cargo 既定のキャレット要件）。
#
# 「外部クレートは追加しない」は本テンプレートの初期状態（雛形出荷時）の
# 設計根拠であり、生成プロジェクトへの恒久的な依存追加禁止ではない
# （イシュー #1115）。雛形は依存グラフを fandhe-frontend-core/fandhe-frontend-app
# の 2 crate のみに保つことで REQ-3（60 件/深さ 6）に余裕を持たせているが、
# 生成後のプロジェクトでは同梱 deny.toml のポリシー（CI: .github/workflows/deny.yml
# が強制）の範囲内で必要な外部クレート（例: serde）を追加してよい。追加時は
# `cargo metadata` で依存件数・深さへの影響を確認し、REQ-3 の目安
# （60 件/深さ 6）を参考にすること。
[dependencies]
fandhe-frontend-core = "0.1.1"
fandhe-frontend-app = "0.1.0"

[dev-dependencies]

# root workspace（リポジトリ直下 Cargo.toml の members）から意図的に切り離す。
# templates/app は「フレームワーク利用者へ配布される独立プロジェクトの雛形」
# であり、root workspace に巻き込まれると `cargo new` 直後の単体プロジェクト
# としての `cargo check`/`cargo test`/`fw gate` の挙動を検証できなくなる
# （templates/default の Cargo.toml と同一方針）。vendor 同梱の廃止（イシュー
# #412）後も、生成プロジェクトを独立ワークスペースとして扱うというこの目的
# 自体は変わらないため `members = ["."]` を維持する。
[workspace]
members = ["."]
